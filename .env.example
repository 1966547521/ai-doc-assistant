# API Base URLs and Model Configuration
LLM_BASE_URL=https://api.deepseek.com/v1
EMBEDDING_MODEL=text-embedding-3-small

# Local Ollama Configuration (Fallback - when API is unavailable)
LOCAL_LLM_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=llama3.2
LOCAL_EMBEDDING_MODEL=nomic-embed-text

# Optional: Admin password for prompt management (required to access admin panel)
ADMIN_PASSWORD=your-secure-password-here

# FastAPI Configuration
API_HOST=0.0.0.0
API_PORT=8000
JWT_SECRET_KEY=change-me-to-a-random-secret-key
